{
  "name": "agent-guard",
  "version": "0.1.0",
  "private": true,
  "author": "Tommy",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-demo.mjs",
    "test": "node --test web/*.test.mjs tests/*.test.mjs",
    "test:contract": "cargo test --workspace --locked",
    "build:contract": "node scripts/build-contract.mjs",
    "test:testnet": "node scripts/verify-testnet.mjs",
    "test:testnet:send": "node scripts/verify-testnet.mjs --send",
    "check:ai": "node scripts/check-near-ai.mjs",
    "check:ai:send": "node --env-file=.env scripts/check-near-ai.mjs --send",
    "benchmark:security": "node scripts/benchmark-security.mjs",
    "benchmark:security:send": "node --env-file=.env scripts/benchmark-security.mjs --send",
    "benchmark:security:replay": "node scripts/replay-security.mjs",
    "test:runtime": "node scripts/test-runtime.mjs",
    "inspect:transaction": "node scripts/inspect-incident.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "dev:live": "node --env-file-if-exists=.env scripts/serve.mjs",
    "verify": "node scripts/verify.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "replay:incident": "node scripts/replay-incident.mjs"
  },
  "engines": {
    "node": ">=22.9"
  }
}
